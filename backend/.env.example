# TripPilot Backend Configuration & Secret Environment Variables

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
PORT=5001
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# MongoDB Database Connection
MONGO_URI=mongodb://localhost:27017/trippilot

# AI Engine / Groq (xAI Grok) Configuration
GROK_API_KEY=your_groq_or_xai_api_key_here
GROK_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=openai/gpt-oss-120b

# Provider Adapters Configuration (mock vs live)
# Set to 'false' when connecting legitimate production travel APIs
FLIGHTS_USE_MOCK=true
HOTELS_USE_MOCK=true
TRAINS_USE_MOCK=true
BUSES_USE_MOCK=true
ACTIVITIES_USE_MOCK=true

# External Travel API Keys (Server-Side Only - Never expose on client)
FLIGHT_PROVIDER_API_KEY=your_flight_api_key_here
HOTEL_PROVIDER_API_KEY=your_hotel_api_key_here
TRAIN_PROVIDER_API_KEY=your_irctc_or_train_api_key_here
BUS_PROVIDER_API_KEY=your_bus_api_key_here
PAYMENT_GATEWAY_KEY=your_razorpay_or_stripe_key_here
